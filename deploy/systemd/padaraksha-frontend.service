# Padaraksha — Next.js frontend service
# Place at: /etc/systemd/system/padaraksha-frontend.service
# Enable:   sudo systemctl enable padaraksha-frontend
# Start:    sudo systemctl start padaraksha-frontend
#
# Run `npm run build` inside /var/www/padaraksha/frontend after every deploy.

[Unit]
Description=Padaraksha Next.js frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/padaraksha/frontend

Environment=NODE_ENV=production
# NEXT_PUBLIC_API_URL is baked in at build time — see deploy/setup.sh
# This env var here is a no-op for the running server but kept for clarity.
Environment=NEXT_PUBLIC_API_URL=https://padaraksha-dev.kutterkitchen.com/api

ExecStart=/var/www/padaraksha/frontend/node_modules/.bin/next start --port 3001

Restart=on-failure
RestartSec=5s

PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
